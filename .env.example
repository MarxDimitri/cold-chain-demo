# Copy to .env (git-ignored) and fill in. Never commit real values.

# --- AWS (central IT bucket) ---
AWS_PROFILE=
AWS_REGION=eu-central-1
# Bucket names are global; `make setup` appends a unique suffix and records the result here.
COLDCHAIN_BUCKET=
# JSON file (git-ignored) mapping store id -> {"access_key_id": "...", "secret_access_key": "..."}.
# Each simulated store writes with its own write-only credentials.
COLDCHAIN_STORE_KEYS_FILE=store-keys.json

# --- Elastic Cloud Hosted ---
# Not read by the code today (kept for reference):
ELASTIC_CLOUD_ID=
ELASTICSEARCH_URL=
KIBANA_URL=
ELASTIC_API_KEY=
# Not read from here: `make setup-elastic` creates the enrollment token and keeps it in .secrets/.
FLEET_ENROLLMENT_TOKEN=
# Used for the collector image tag (docker compose); the author used 9.5.6.
ELASTIC_STACK_VERSION=

# --- Federation (read-only role or key limited to raw/*) ---
# Not read by the code today: the federation data source uses the read-only key in .secrets/federation.json.
FEDERATION_ROLE_ARN=

COLDCHAIN_DETECT_QUEUE_URL=
COLDCHAIN_DETECT_DLQ_URL=
